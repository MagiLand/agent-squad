#!/usr/bin/env python3
"""Compare two source trees on one disposable, initialized PR fixture.

Usage: python scripts/measure-cli-processes BASE_TREE CANDIDATE_TREE OUTPUT_DIR
The output directory holds raw process records and grouped counts. No real
forge, Herdr session, or model is used. Use the interpreter being measured.
"""

from collections import Counter
import json
import os
from pathlib import Path
import subprocess
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from tests.forge_support import ForgeFixture  # noqa: E402


def measure(fixture, source, probe, output, label, command):
    log = output / (label + "-" + command[0] + ".jsonl")
    log.write_text("")
    env = {
        **fixture.env,
        "PYTHONPATH": os.pathsep.join((str(probe), str(source / "src"))),
        "SQUAD_PROCESS_LOG": str(log),
    }
    with subprocess.Popen(
        [sys.executable, "-m", "agent_squad", *command, "--json"],
        cwd=fixture.repo, env=env, text=True, shell=False,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    ) as process:
        stdout, stderr = process.communicate(timeout=90)
        if process.returncode:
            raise RuntimeError(f"{label} {command}: {stdout}\n{stderr}")
        records = [json.loads(line) for line in log.read_text().splitlines()]
        grouped = {}
        for name, direct in (("direct", True), ("grandchildren", False)):
            grouped[name] = dict(sorted(Counter(
                " ".join((Path(row["args"][0]).name, *row["args"][1:2]))
                for row in records if (row["pid"] == process.pid) == direct
            ).items()))
        return {
            "command": list(command), "cli_pid": process.pid,
            "total": len(records), "counts": grouped,
        }


def main():
    if len(sys.argv) != 4:
        raise SystemExit(__doc__)
    baseline, candidate, output = (
        Path(arg).resolve() for arg in sys.argv[1:]
    )
    output.mkdir(parents=True, exist_ok=True)
    probe = (Path(__file__).resolve().parents[1]
             / "tests/fixtures/process_probe")
    results = {}
    with ForgeFixture() as fixture:
        fixture.initialize()
        fixture.candidate()
        fixture.create_pr()
        # Restore the same fake server state before each observed command.
        forge = fixture.read_model()
        herdr = fixture.herdr_model()
        for label, source in (
            ("baseline", baseline), ("candidate", candidate),
        ):
            results[label] = []
            for command in (("pr", "head", "--pr", "1"),
                            ("status", "--pr", "1"), ("doctor",)):
                fixture.save_model(forge)
                fixture.save_herdr(herdr)
                results[label].append(
                    measure(fixture, source, probe, output, label, command),
                )
    result = {"python": sys.version, "sources": {
        "baseline": str(baseline), "candidate": str(candidate),
    }, "results": results}
    (output / "counts.json").write_text(json.dumps(result, indent=2) + "\n")
    print(json.dumps(result, indent=2))


if __name__ == "__main__":
    main()
