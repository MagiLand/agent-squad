#!/usr/bin/env python3
"""Scriptable GitHub fixture. Tokens in this model are exclusively fake."""

import json
import os
import re
import sys
from urllib.parse import parse_qs, unquote, urlsplit

model_path = os.environ["FAKE_FORGE_MODEL"]
with open(model_path) as stream:
    model = json.load(stream)
settings = model.setdefault("settings", {})
arguments = sys.argv[1:]
token = os.environ.get("GH_TOKEN")
account = token.removeprefix("fake-token-") if token else None
payload = json.load(sys.stdin) if "--input" in arguments else None
model.setdefault("calls", []).append(
    {
        "arguments": arguments,
        "GH_TOKEN": token,
        "account": account,
        "body": payload,
    }
)


def save():
    with open(model_path, "w") as stream:
        stream.write(json.dumps(model, indent=2) + "\n")


def output(value):
    save()
    print(json.dumps(value))
    raise SystemExit(0)


def fail(message, status=422):
    save()
    print(f"gh: {message} (HTTP {status})", file=sys.stderr)
    raise SystemExit(1)


def record(body, author=None):
    from datetime import datetime, timedelta, timezone

    model["next_id"] = model.get("next_id", 100) + 1
    ident = model["next_id"]
    date = datetime(2026, 1, 1, tzinfo=timezone.utc) + timedelta(seconds=ident)
    return {
        "id": ident,
        "body": body,
        "user": {"login": author or account},
        "created_at": date.isoformat().replace("+00:00", "Z"),
    }


def remote_sha(branch):
    import subprocess

    result = subprocess.run(
        ["git", "rev-parse", f"refs/heads/{branch}"],
        cwd=model["origin"],
        text=True,
        capture_output=True,
        check=True,
    )
    return result.stdout.strip()


def refresh(pr):
    if pr["state"] == "open" and model.get("origin"):
        pr["head"]["sha"] = remote_sha(pr["head"]["ref"])
    return pr


def review_record(pr, body, event, head):
    review = record(body)
    review.update(
        commit_id=head,
        state={
            "APPROVE": "APPROVED",
            "REQUEST_CHANGES": "CHANGES_REQUESTED",
            "COMMENT": "COMMENTED",
            "PENDING": "PENDING",
        }[event],
    )
    review["submitted_at"] = (
        None if event == "PENDING" else review["created_at"]
    )
    pr.setdefault("reviews", []).append(review)
    return review


def root_record(pr, body, anchor, review_id=None):
    if review_id is None:
        review_id = review_record(pr, "", "COMMENT", anchor["commit_id"])["id"]
    comment = record(body)
    comment.update(
        pull_request_review_id=review_id,
        path=anchor["path"],
        line=anchor["line"],
        start_line=anchor.get("start_line"),
        side="RIGHT",
        in_reply_to_id=None,
    )
    pr.setdefault("comments", []).append(comment)
    pr.setdefault("threads", []).append(
        {
            "id": f'T-{comment["id"]}',
            "isResolved": False,
            "comments": {"nodes": [{"databaseId": comment["id"]}]},
        }
    )
    return comment


def paged(values, query):
    size = int(query.get("per_page", ["100"])[0])
    page = int(query.get("page", ["1"])[0])
    return values[(page - 1) * size:page * size]


def graphql_errors(data, errors):
    # gh exits 1 on a response with errors but still prints it.
    save()
    print(json.dumps({"data": data, "errors": errors}))
    print("gh: " + "\n".join(e["message"] for e in errors), file=sys.stderr)
    raise SystemExit(1)


# GraphQL view of the REST-shaped model (#149). Each list is paged with a
# size from settings["page_sizes"]["<Owner>.<list>"] and an offset cursor.
def gql_page(values, key, cursor=None):
    default = settings.get("thread_page_size", 100) if (
        key == "PullRequest.reviewThreads") else 100
    size = settings.get("page_sizes", {}).get(key, default)
    offset = int(cursor or 0)
    has_next = offset + size < len(values)
    return {
        "nodes": values[offset:offset + size],
        "pageInfo": {
            "hasNextPage": has_next,
            "endCursor": str(offset + size) if has_next else None,
        },
    }


def gql_actor(user):
    # GraphQL names an app account without [bot]; a deleted one is null.
    if user is None:
        return None
    if user["login"].endswith("[bot]"):
        return {"__typename": "Bot", "login": user["login"][:-5]}
    return {"__typename": "User", "login": user["login"]}


def gql_evidence(value):
    return {
        "fullDatabaseId": str(value["id"]),
        "author": gql_actor(value.get("user")),
        "body": value.get("body") or "",
        "createdAt": value.get("created_at"),
    }


def gql_comment(comment):
    reply = comment.get("in_reply_to_id")
    return {
        **gql_evidence(comment),
        "path": comment.get("path"),
        "line": comment.get("line"),
        "originalLine": comment.get("original_line"),
        "startLine": comment.get("start_line"),
        "originalStartLine": comment.get("original_start_line"),
        "replyTo": None if reply is None else {"fullDatabaseId": str(reply)},
        "pullRequestReview": {
            "fullDatabaseId": str(comment["pull_request_review_id"])
        },
    }


def review_lists(pr, review):
    return {"comments": [
        gql_comment(c) for c in pr.get("comments", [])
        if c["pull_request_review_id"] == review["id"]
    ]}


def thread_lists(pr, thread):
    root = thread["comments"]["nodes"][0]["databaseId"]
    comments = pr.get("comments", [])
    # omit_flat_replies also leaves replies out of a thread's comments.
    members = [c for c in comments if c["id"] == root] + [
        c for c in comments if c.get("in_reply_to_id") == root
        and not settings.get("omit_flat_replies")
    ]
    return {"comments": [gql_comment(c) for c in members]}


def gql_review(pr, review):
    return {
        **{k: v for k, v in gql_evidence(review).items() if k != "createdAt"},
        "id": f"PRR-{review['id']}",
        "state": review["state"],
        "submittedAt": review.get("submitted_at"),
        "commit": {"oid": review["commit_id"]},
        "comments": gql_page(
            review_lists(pr, review)["comments"], "PullRequestReview.comments"
        ),
    }


def gql_thread(pr, thread):
    root = thread["comments"]["nodes"][0]["databaseId"]
    side = next(
        (c.get("side") for c in pr.get("comments", []) if c["id"] == root),
        None,
    )
    return {
        "id": thread["id"],
        "isResolved": thread["isResolved"],
        "diffSide": side,
        "comments": gql_page(
            thread_lists(pr, thread)["comments"],
            "PullRequestReviewThread.comments",
        ),
    }


def pr_lists(pr):
    return {
        "reviews": [gql_review(pr, r) for r in pr.get("reviews", [])],
        # A thread is served only while its root comment exists.
        "reviewThreads": [
            gql_thread(pr, t) for t in pr.get("threads", [])
            if any(c["id"] == t["comments"]["nodes"][0]["databaseId"]
                   for c in pr.get("comments", []))
        ],
        "comments": [gql_evidence(c) for c in pr.get("conversation", [])],
    }


def gql_pull(number, pr):
    merge = pr.get("merge_commit_sha")
    lists = pr_lists(pr)
    return {
        **gql_evidence(pr),
        "id": f"PR-{number}",
        "number": pr["number"],
        "title": pr["title"],
        "headRefOid": pr["head"]["sha"],
        "headRefName": pr["head"]["ref"],
        "baseRefOid": pr["base"]["sha"],
        "baseRefName": pr["base"]["ref"],
        "state": "MERGED" if pr["merged"] else pr["state"].upper(),
        "merged": pr["merged"],
        "mergeCommit": {"oid": merge} if merge and pr["merged"] else None,
        "potentialMergeCommit": (
            {"oid": merge} if merge and not pr["merged"] else None
        ),
        "mergeStateStatus": (
            None if pr.get("mergeable_state") is None
            else pr["mergeable_state"].upper()
        ),
        **{key: gql_page(lists[key], f"PullRequest.{key}") for key in lists},
    }


def recorded_checks(sha, advance):
    # Each complete read takes the next scripted state.
    checks = model.setdefault("checks", {})
    sequence = model.get("check_sequence", {}).get(sha)
    if advance and sequence:
        checks[sha] = sequence.pop(0)
    return checks.get(sha, {})


def latest_runs(runs):
    latest = {}
    for run in runs:
        key = (run.get("check_suite", {}).get("id"), run["name"])
        latest.pop(key, None)
        latest[key] = run
    return list(latest.values())


def latest_statuses(statuses):
    latest = {}
    for status in statuses:
        latest.pop(status["context"], None)
        latest[status["context"]] = status
    return list(latest.values())


def commit_lists(sha, advance=False):
    recorded = recorded_checks(sha, advance)
    events = {w["check_suite_id"]: w["event"]
              for w in recorded.get("workflow_runs", [])}
    runs = latest_runs(recorded.get("check_runs", []))
    suites = {}
    for index, run in enumerate(runs):
        suite = run.get("check_suite", {}).get("id")
        suites.setdefault(suite, []).append({
            # GitHub lists check runs newest first; number them so.
            "databaseId": len(runs) - index,
            "name": run["name"],
            "status": run["status"].upper(),
            "conclusion": (run["conclusion"] or "").upper() or None,
            "permalink": run.get("html_url"),
            "startedAt": run.get("started_at"),
            "completedAt": run.get("completed_at"),
        })
    rows = latest_statuses(recorded.get("statuses", []))
    return {
        "checkSuites": [
            {
                "id": f"CS-{sha}-{suite}",
                "app": next(r.get("app") for r in runs
                            if r.get("check_suite", {}).get("id") == suite),
                "workflowRun": (
                    {"event": events[suite]} if suite in events else None
                ),
                "checkRuns": gql_page(nodes, "CheckSuite.checkRuns"),
            }
            for suite, nodes in suites.items()
        ],
        "suites": suites,
        "status": {"contexts": [
            {
                "context": s["context"],
                "state": s["state"].upper(),
                "targetUrl": s.get("target_url"),
                "creator": gql_actor(s.get("creator")),
            }
            for s in rows
        ]} if rows else None,
    }


def gql_commit(sha):
    lists = commit_lists(sha, advance=True)
    return {
        "id": f"C-{sha}",
        "oid": sha,
        "checkSuites": gql_page(lists["checkSuites"], "Commit.checkSuites"),
        "status": lists["status"],
    }


def owner_lists(node_id):
    kind, _, key = node_id.partition("-")
    if kind == "PR":
        return pr_lists(refresh(prs_model()[key]))
    for pr in prs_model().values():
        for review in pr.get("reviews", []):
            if f"PRR-{review['id']}" == node_id:
                return review_lists(pr, review)
        for thread in pr.get("threads", []):
            if thread["id"] == node_id:
                return thread_lists(pr, thread)
    if kind == "C":
        return {"checkSuites": commit_lists(key)["checkSuites"]}
    if kind == "CS":
        sha, _, suite = key.rpartition("-")
        nodes = commit_lists(sha)["suites"]
        return {"checkRuns": next(
            v for k, v in nodes.items() if str(k) == suite
        )}
    fail("unknown node " + node_id, 404)


def prs_model():
    return model.setdefault("prs", {})


def checks_refused(alias):
    return [{
        "type": "FORBIDDEN", "path": ["repository", alias],
        "message": "Resource not accessible by integration",
    }]


if arguments == ["--version"]:
    save()
    print(settings.get("version", "gh version fixture-1"))
    raise SystemExit(0)
if arguments[:3] == ["auth", "token", "--user"]:
    requested = arguments[3]
    if requested in settings.get("token_failure", []):
        fail("credential store unavailable: fake-token-" + requested, 401)
    save()
    print(settings.get("token_response", {}).get(
        requested, "fake-token-" + requested,
    ))
    raise SystemExit(0)
if not arguments or arguments[0] != "api":
    fail("unsupported command", 400)
if not token or not token.startswith("fake-token-"):
    fail("fake token required", 401)
endpoint = arguments[1]
method = (
    arguments[arguments.index("--method") + 1]
    if "--method" in arguments
    else "GET"
)
if endpoint == "/user":
    if account in settings.get("user_failure", []):
        fail("user unavailable: " + token, 401)
    if account in settings.get("user_response", {}):
        output(settings["user_response"][account])
    output({"login": settings.get("login_mismatch", account)})
if endpoint == "graphql":
    variables = payload["variables"]
    if "resolveReviewThread" in payload["query"]:
        for pr in model.get("prs", {}).values():
            for thread in pr.get("threads", []):
                if thread["id"] == variables["id"]:
                    thread["isResolved"] = True
                    output(
                        {
                            "data": {
                                "resolveReviewThread": {
                                    "thread": {
                                        "id": thread["id"],
                                        "isResolved": True,
                                    }
                                }
                            }
                        }
                    )
        fail("unknown thread", 404)
    operation = payload["query"].split("(", 1)[0].split()[-1]
    if operation == "SquadSnapshot":
        number = str(variables["pr"])
        if number not in prs_model():
            graphql_errors({"repository": {"pullRequest": None}}, [{
                "type": "NOT_FOUND", "path": ["repository", "pullRequest"],
                "message": "Could not resolve to a PullRequest with the"
                f" number of {number}.",
            }])
        pr = refresh(prs_model()[number])
        repository = {"pullRequest": gql_pull(number, pr)}
        if variables["checks"]:
            if account in settings.get("checks_denied", []):
                repository["head"] = None
                graphql_errors({"repository": repository},
                               checks_refused("head"))
            # The PR's head ref names its current head commit.
            repository["head"] = gql_commit(pr["head"]["sha"])
        output({"data": {"repository": repository}})
    if operation == "SquadChecks":
        if account in settings.get("checks_denied", []):
            graphql_errors({"repository": {"object": None}},
                           checks_refused("object"))
        output({"data": {"repository": {
            "object": gql_commit(variables["sha"])
        }}})
    if operation == "SquadPage":
        import re

        owner, field = re.search(
            r"\.\.\. on (\w+) \{ (\w+)\(", payload["query"]
        ).groups()
        lists = owner_lists(variables["id"])
        output({"data": {"node": {field: gql_page(
            lists[field], f"{owner}.{field}", variables["cursor"]
        )}}})
    if operation != "SquadThreads":
        fail("unknown GraphQL operation " + operation, 400)
    # The thread read before #149, kept for older source trees.
    pr = model["prs"][str(variables["pr"])]
    offset = int(variables.get("cursor") or 0)
    size = settings.get("thread_page_size", 100)
    threads = pr.get("threads", [])
    has_next = offset + size < len(threads)
    output(
        {
            "data": {
                "repository": {
                    "pullRequest": {
                        "reviewThreads": {
                            "nodes": threads[offset:offset + size],
                            "pageInfo": {
                                "hasNextPage": has_next,
                                "endCursor": (
                                    str(offset + size) if has_next else None
                                ),
                            },
                        }
                    }
                }
            }
        }
    )

parsed = urlsplit(endpoint)
query = parse_qs(parsed.query)
parts = [unquote(part) for part in parsed.path.strip("/").split("/")]
if len(parts) == 3 and parts[0] == "repos":
    if account in settings.get("repository_denied", []):
        fail("repository unreadable: " + token, 403)
    repository = {
        "id": 1,
        "full_name": "/".join(parts[1:3]),
        "permissions": {"push": True},
    }
    # GitHub omits the field from some reads, such as an anonymous one.
    if "delete_branch_on_merge" in settings:
        repository["delete_branch_on_merge"] = settings[
            "delete_branch_on_merge"]
    output(repository)
if len(parts) < 4 or parts[0] != "repos":
    fail("unsupported endpoint", 404)
kind = parts[3]
number = parts[4] if len(parts) > 4 else None
prs = model.setdefault("prs", {})
if kind == "collaborators" and parts[5:] == ["permission"]:
    if settings.get("permission_failure"):
        fail("permission lookup denied: " + token, 403)
    output(settings.get("permission_response", {
        "permission": settings.get("permission", "write"),
        "role_name": settings.get("role_name", "write"),
        "user": {"login": number},
    }))
if kind == "git" and parts[4] in ("ref", "refs"):
    import subprocess

    if method == "GET" and settings.get("branch_read_403"):
        fail("branch unreadable", 403)
    branch = "/".join(parts[6:])
    ref = f"refs/heads/{branch}"
    pending = model.get("pending_auto_deletion")
    if method == "GET" and pending and pending["ref"] == ref:
        # GitHub's automatic deletion lands after the merge response.
        pending["reads"] -= 1
        if pending["reads"] <= 0:
            del model["pending_auto_deletion"]
            subprocess.run(["git", "update-ref", "-d", ref],
                           cwd=model["origin"], check=True, shell=False)
    if method == "DELETE" and settings.get("branch_removed_before_delete"):
        # Another deletion completes between the branch read and the DELETE.
        subprocess.run(["git", "update-ref", "-d", ref],
                       cwd=model["origin"], check=True, shell=False)
    result = subprocess.run(
        ["git", "show-ref", "--verify", ref], cwd=model["origin"],
        text=True, capture_output=True, shell=False,
    )
    if result.returncode:
        if method == "DELETE":
            fail("Reference does not exist",
                 settings.get("absent_delete_status", 422))
        fail("branch not found", 404)
    head = result.stdout.split()[0]
    if method == "DELETE":
        if settings.get("branch_delete_403"):
            fail("branch deletion forbidden", 403)
        if settings.get("branch_delete_status"):
            fail("Reference does not exist", settings["branch_delete_status"])
        subprocess.run(["git", "update-ref", "-d", ref, head],
                       cwd=model["origin"], check=True, shell=False)
        output(None)
    output({"ref": ref, "object": {"sha": head}})
if kind in ("branches", "rules"):
    if settings.get("rules_status"):
        fail(settings.get("rules_message", "rules unavailable"),
             settings["rules_status"])
    if kind == "branches":
        output(settings.get("protection", {}))
    output(paged(settings.get("rules", []), query))
if (kind == "commits" and parts[5:] in (["check-runs"], ["status"])) or (
    kind == "actions" and parts[4:] == ["runs"]
):
    # Checks at one commit: model["checks"][sha] holds every check run
    # attempt, every commit status in creation order, and the workflow runs.
    if account in settings.get("checks_denied", []):
        fail("Resource not accessible by integration", 403)
    sha = number if kind == "commits" else query.get("head_sha", [""])[0]
    first = query.get("page", ["1"])[0] == "1"
    recorded = recorded_checks(sha, parts[5:] == ["check-runs"] and first)
    if kind == "actions":
        runs = recorded.get("workflow_runs", [])
        output({"total_count": len(runs), "workflow_runs": paged(runs, query)})
    if parts[5] == "check-runs":
        runs = recorded.get("check_runs", [])
        if query.get("filter", ["latest"])[0] == "latest":
            runs = latest_runs(runs)
        output({"total_count": len(runs), "check_runs": paged(runs, query)})
    rows = latest_statuses(recorded.get("statuses", []))
    states = {status["state"] for status in rows}
    output({
        # GitHub reports pending for a commit without statuses.
        "state": (
            "failure" if states & {"failure", "error"}
            else "pending" if "pending" in states or not rows
            else "success"
        ),
        "sha": sha,
        "total_count": len(rows),
        "statuses": paged(rows, query),
    })
if kind == "labels":
    output(paged(model.get("labels", []), query))
if kind == "issues":
    # GitHub numbers issues and PRs together; this model numbers them apart,
    # so the fixtures' issue 1 and PR 1 share a number.
    def as_issue(key):
        if key in model["issues"]:
            return model["issues"][key]
        # The issues API serves a PR number as an issue marked as a PR.
        pull = prs[key]
        return {
            **{k: pull[k] for k in (
                "id", "number", "title", "state", "body", "user",
                "created_at",
            )},
            "labels": [],
            "pull_request": {
                "url": "https://api.github.com/repos/"
                + "/".join(parts[1:3]) + f"/pulls/{key}",
            },
        }

    if number is None:
        if method == "POST":
            # A new issue takes a number above every issue and PR, as on
            # GitHub. Only existing labels apply; whether GitHub creates a
            # missing one is unverified (spec section 19).
            number = str(max(map(int, [*model["issues"], *prs, "0"])) + 1)
            names = [] if settings.get("drop_issue_labels") else [
                label["name"] for label in model.get("labels", [])
                if label["name"] in payload.get("labels", [])
            ]
            issue = record(payload.get("body"))
            issue.update(
                number=int(number), title=payload["title"], state="open",
                labels=[{"name": name} for name in names], conversation=[],
            )
            model["issues"][number] = issue
            output(issue)
        state = query.get("state", ["open"])[0]
        keys = sorted({*model["issues"], *prs}, key=int, reverse=True)
        output(paged(
            [as_issue(k) for k in keys
             if state in ("all", as_issue(k)["state"])],
            query,
        ))
    issue = model["issues"].get(number)
    pull = prs.get(number)
    if len(parts) == 5:
        if issue is None and pull is None:
            fail("issue not found", 404)
        output(as_issue(number))
    if parts[5:] == ["comments"]:
        # Decisions and stops on a shared number reach the PR; an issue note
        # there is refused rather than silently written to the PR.
        target = pull or issue
        if target is None:
            fail("issue not found", 404)
        if method == "POST":
            note = payload["body"].startswith("AGENT_SQUAD/0.5.0 NOTE ")
            if note and issue is not None and pull is not None:
                fail(f"fixture issue and PR share number {number}", 409)
            comment = record(payload["body"])
            target.setdefault("conversation", []).append(comment)
            output(comment)
        output(paged(target.get("conversation", []), query))
if kind != "pulls":
    fail("unsupported endpoint", 404)
if number is None:
    if method == "POST":
        number = str(max([int(k) for k in prs] + [0]) + 1)
        pr = record(payload["body"])
        pr.update(
            number=int(number),
            title=payload["title"],
            head={"ref": payload["head"], "sha": remote_sha(payload["head"])},
            base={"ref": payload["base"], "sha": remote_sha(payload["base"])},
            state="open",
            merged=False,
            merge_commit_sha=None,
            mergeable_state="clean",
            reviews=[],
            comments=[],
            conversation=[],
            threads=[],
        )
        prs[number] = pr
        output(pr)
    head = query.get("head", [""])[0].partition(":")[2]
    output(
        paged(
            [refresh(pr) for pr in prs.values() if pr["head"]["ref"] == head],
            query,
        )
    )
if number not in prs:
    fail("pull request not found", 404)
pr = refresh(prs[number])
if len(parts) == 5:
    if method == "PATCH":
        if settings.get("fail_mirror"):
            fail("injected Task mirror failure", 503)
        pr["body"] = payload["body"]
    output(pr)
if parts[5] == "merge":
    import subprocess
    import tempfile

    if method != "PUT":
        fail("merge requires PUT", 400)

    def lost():
        # A transport failure carries no HTTP status: the outcome is unknown.
        save()
        print("gh: connection reset by peer", file=sys.stderr)
        raise SystemExit(1)

    # merge_response_lost: "before" loses the request, "after" the answer.
    if settings.get("merge_response_lost") == "before":
        lost()
    if settings.get("merge_refusal"):
        fail(settings["merge_refusal"], 405)
